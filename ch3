        "c = tf.sqrt(a)\n",
        "d = b + c\n",
        "e = tf.matmul(a, b)   # matmul: matrix multiplication\n",
        "f = tf.concat((a, b), axis=0)   # concatenate (axis=0: 첫 번째 축(세로) 방향으로 병합)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 18,
      "metadata": {
        "id": "CEAhbz_qQQMM"
      },
      "outputs": [],
      "source": [
        "def dense(inputs, W, b):\n",
        "    return tf.nn.relu(tf.matmul(inputs, W) + b)\n",
        "# output = ReLU(inputs*W + b)  (W: weight, b: bias)\n",
        "# nn: neural network\n",
        "# TensorFlow의 신경망 관련 함수 중 ReLU를 사용"
      ]
    },
