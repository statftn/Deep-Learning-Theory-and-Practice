      "outputs": [],
      "source": [
        "def training_step(inputs, targets):   # inputs(입력 데이터)와 targets(정답 데이터)를 입력으로 받는 함수 설정\n",
        "    predictions = model(inputs)   # predictions = inputs × W + b\n",
        "    loss = mean_squared_error(targets, predictions)\n",
        "    loss.backward()   # W와 b의 gradient 계산\n",
        "    optimizer.step()   # W와 b 업데이트\n",
        "    model.zero_grad()   # gradient를 0으로 초기화\n",
        "    return loss"
      ]
    },
