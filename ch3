      "source": [
        "import numpy as np\n",
        "\n",
        "num_samples_per_class = 1000\n",
        "\n",
        "negative_samples = np.random.multivariate_normal(\n",
        "    mean=[0, 3], cov=[[1, 0.5], [0.5, 1]], size=num_samples_per_class\n",
        ")\n",
        "positive_samples = np.random.multivariate_normal(\n",
        "    mean=[3, 0], cov=[[1, 0.5], [0.5, 1]], size=num_samples_per_class\n",
        ")\n",
        "# 2D 평면에 두 클래스의 랜덤한 포인트 생성\n",
        "# negative_sample와 positive_samples 모두 (1000, 2) 크기의 배열"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 34,
      "metadata": {
        "id": "KLHdMr0GQQMN"
      },
      "outputs": [],
      "source": [
        "inputs = np.vstack((negative_samples, positive_samples)).astype(np.float32)\n",
        "# 두 클래스를 수직으로 연결하여 (2000, 2) 크기의 한 배열로 쌓기"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 35,
      "metadata": {
        "id": "ptAVf35AQQMN"
      },
      "outputs": [],
      "source": [
        "targets = np.vstack(\n",
        "    (\n",
        "        np.zeros((num_samples_per_class, 1), dtype=\"float32\"),\n",
        "        np.ones((num_samples_per_class, 1), dtype=\"float32\")\n",
        "    )\n",
        ")\n",
        "# (1000, 1) 크기의 0과 1로 구성된 타깃 레이블을 한 배열로 쌓기 -> (2000, 1) 크기 타깃 레이블\n",
        "# inputs[i]가 클래스 0에 속하면 target[i, 0]은 0"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 36,
