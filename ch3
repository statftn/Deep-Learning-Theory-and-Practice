        "b = torch.zeros(output_dim, requires_grad=True)   # 0텐서 (1x1)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 64,
      "metadata": {
        "id": "UsvEFiKYQQMT"
      },
      "outputs": [],
      "source": [
        "def model(inputs, W, b):\n",
        "    return torch.matmul(inputs, W) + b\n",
        "# y = xW + b\n",
        "# predictions = [[w1], [w2]] • [x, y] + b = w1 * x + w2 * y + b"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 65,
      "metadata": {
        "id": "hBo5H0mYQQMT"
      },
      "outputs": [],
      "source": [
        "def mean_squared_error(targets, predictions):\n",
        "    per_sample_losses = torch.square(targets - predictions)\n",
        "    return torch.mean(per_sample_losses)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 66,
      "metadata": {
        "id": "Rw-lfJgZQQMT"
      },
      "outputs": [],
      "source": [
        "learning_rate = 0.1   # 한 번에 얼마나 크게 가중치를 수정할지 결정 (너무 크면 최적값을 지나칠 수 있고, 너무 작으면 학습이 느림)\n",
        "\n",
        "def training_step(inputs, targets, W, b):\n",
        "    predictions = model(inputs)\n",
        "    loss = mean_squared_error(targets, predictions)\n",
        "    loss.backward()\n",
        "    grad_loss_wrt_W, grad_loss_wrt_b = W.grad, b.grad\n",
        "    with torch.no_grad():\n",
        "        W -= grad_loss_wrt_W * learning_rate   # 경사하강법으로 가중치 W 업데이트  (W <- W - (dl/dW)*learning_rate)\n",
        "        b -= grad_loss_wrt_b * learning_rate   # b 업데이트 (b <- b - (dl/db)*learning_rate)\n",
        "    W.grad = None   # resets gradients\n",
        "    b.grad = None\n",
        "    return loss"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "0RM3H5SXQQMT"
      },
      "source": [
        "##### Packaging state and computation with the Module class"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# torch.nn.Module 클래스와 torch.optim module에서의 optimizer 클래스를 이용하여 backpropagation 진행"
      ],
      "metadata": {
        "id": "FzqPaArYTTGN"
      },
      "execution_count": 67,
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": 68,
      "metadata": {
        "id": "bEbuG954QQMU"
      },
      "outputs": [],
      "source": [
        "# Hold some Parameters, to store state variables. Those are defined in the __init__() method\n",
        "# Implement the forward pass computation in the forward() method\n",
        "class LinearModel(torch.nn.Module):   # LinearModel: 만드려는 모델의 이름. torch.nn.Module: 신경망 모델의 기본 클래스\n",
        "    # LinearModel이라는 객체를 만들 때 처음에 W와 b를 준비\n",
        "    # __init__(): 파이썬 클래스의 객체가 만들어질 때 필요한 변수나 설정을 처음 준비하는 함수\n",
        "    def __init__(self):   # self: 현재 만들어지고 있는 객체 자신\n",
        "        super().__init__()   # 부모 클래스인 torch.nn.Module의 초기화도 먼저 수행\n",
        "        self.W = torch.nn.Parameter(torch.rand(input_dim, output_dim))   # U(0, 1)의 랜덤한 초기값으로 구성된 학습 가능한 parameter W\n",
        "        self.b = torch.nn.Parameter(torch.zeros(output_dim))   # 0으로 초기화된 bias. 학습 가능한 parameter\n",
        "    # 모델에 입력값이 들어왔을 때 어떤 계산을 수행할지 정의\n",
        "    def forward(self, inputs):\n",
        "        return torch.matmul(inputs, self.W) + self.b   # y = xW + b"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 69,
      "metadata": {
        "id": "YkLr-1awQQMU"
      },
      "outputs": [],
      "source": [
        "model = LinearModel()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 70,
      "metadata": {
        "id": "UTgC8x4cQQMU"
      },
      "outputs": [],
      "source": [
        "torch_inputs = torch.tensor(inputs)\n",
        "output = model(torch_inputs)   # inputs × W + b"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 71,
      "metadata": {
        "id": "dStAL7qVQQMU"
      },
      "outputs": [],
      "source": [
        "optimizer = torch.optim.SGD(model.parameters(), lr=learning_rate)\n",
        "# Stochastic Gradient Descent 최적화\n",
        "# model.parameters()에 있는 W와 b를 SGD를 이용하여 학습\n",
        "# lr: learning_rate는 앞에서 0.01로 설정"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 72,
      "metadata": {
        "id": "B1VMaAbGQQMU"
