      "source": [
        "##### Making TensorFlow functions fast using compilation"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 31,
      "metadata": {
        "id": "-73oVYG9QQMN"
      },
      "outputs": [],
      "source": [
        "@tf.function   # 아래 dense 함수를 TensorFlow 그래프로 변환하여 연산을 효율적으로 실행할 수 있게 한다\n",
        "def dense(inputs, W, b):\n",
        "    return tf.nn.relu(tf.matmul(inputs, W) + b)\n",
        "# output = ReLU(inputs*W + b) (W: weight, b: bias)\n",
        "# nn: neural network\n",
        "\n",
        "# 일반적으로 Python함수는 순서대로 연산 (속도 느림)\n",
        "# compiliation을 통해 더 빠르고 효율적으로 계산 가능 (하지만 디버깅이 어려움)\n",
        "# 처음 실행할 때는 코드를 compile하여 시간이 더 많이 걸릴 수 있으나, 이후로는 같은 함수를 사용할 때 더 빠르게 실행된다\n",
        "# Python 함수 -> @tf.function -> TensorFlow 계산 그래프 -> 각 연산 실행"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 32,
      "metadata": {
        "id": "aPqoFFweQQMN"
      },
      "outputs": [],
      "source": [
        "@tf.function(jit_compile=True)\n",
        "def dense(inputs, W, b):\n",
        "    return tf.nn.relu(tf.matmul(inputs, W) + b)\n",
        "# jit_compile: Just-In-Time compilation\n",
        "# TensorFlow 그래프를 XLA(Accelerated Linear Algebra) (ML용 고성능 컴파일러) 로 컴파일하여 실행\n",
        "# jit_compile=True인 경우: Python 함수 -> @tf.function -> TensorFlow 계산 그래프 -> XLA 컴파일 -> 최적화된 연산 실행\n",
        "# XLA는 여러 연산을 분석해서 그래프 모드보다 더 효율적인 실행 코드로 컴파일\n",
        "# (다만, 첫 실행에서는 compiler가 더 많은 작업을 해야 해서 함수 실행에 더 많은 시간 소요)"
      ]
    },
