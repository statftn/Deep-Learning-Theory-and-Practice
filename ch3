      "source": [
        "model = keras.Sequential([keras.layers.Dense(1)])\n",
        "model.compile(\n",
        "    optimizer=\"rmsprop\",   # \"rmsprop\": keras.optimizers.RMSprop() (약어를 쓰면 learning_rate와 같은 세부 설정 지정 불가)\n",
        "    loss=\"mean_squared_error\",   # \"mean_squared_error\": keras.losses.MeanSquaredError()\n",
        "    metrics=[\"accuracy\"],   # \"accuracy\": Keras가 모델의 출력 형태와 사용하는 loss 등에 따라 적절한 accuracy metric을 선택하도록 맡기는 방식\n",
        ")\n",
        "# compile: 모델을 어떻게 학습할지 결정\n",
        "# optimizer: 모델의 가중치를 업데이트하는 데 사용되는 최적화 알고리즘 (손실에 대한 그레디언트가 파라미터를 업데이트하는 정확한 방식을 정의)\n",
        "# loss: 모델의 예측이 얼마나 틀렸는지를 측정하는 함수\n",
        "# metrics: 훈련 및 테스트 단계에서 모델의 성능을 평가하는 데 사용되는 지표"
      ]
