      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "plt.scatter(inputs[:, 0], inputs[:, 1], c=targets[:, 0])   # c: color (target에서 구분된 label에 따라 색상 구분)\n",
        "plt.show()"
