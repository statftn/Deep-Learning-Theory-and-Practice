      },
      "source": [
        "##### Gradients in TensorFlow: A second look at the GradientTape API"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# TensorFlow는 NumPy와 달리 미분 가능한 표현이라면 어떤 입력에 대해서도 gradient 계산 가능\n",
        "# GradientTape 블록을 시작하고 하나 또는 여러 입력 텐서에 대해 계산 수행 후 입력에 대해 gradient 계산"
      ],
      "metadata": {
        "id": "z7jFEs9TRHsp"
      },
      "execution_count": 19,
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": 20,
      "metadata": {
        "id": "coLGu4rWQQMM"
      },
      "outputs": [],
      "source": [
        "input_var = tf.Variable(initial_value=3.0)   # 초기값 3.0으로 설정\n",
        "with tf.GradientTape() as tape:   # tf.GradientTape: tf.Variable관련 모든 연산이 기록되어 gradient계산에 사용\n",
        "    result = tf.square(input_var)   # y = x^2\n",
        "gradient = tape.gradient(result, input_var)   # result(y)의 input_var(x)에 대한 기울기 계산"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "gradient\n",
        "# y = x^2의 미분은 dy/dx = 2x이므로, input_var가 3.0일 때 기울기는 2 * 3.0 = 6.0"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "GNGR3cm7AJKZ",
        "outputId": "6a6122eb-6ddc-4116-cb97-c96eac830202"
      },
      "execution_count": 21,
      "outputs": [
        {
          "output_type": "execute_result",
