    {
      "cell_type": "code",
      "execution_count": 37,
      "metadata": {
        "id": "hLPhxDgXQQMN"
      },
      "outputs": [],
      "source": [
        "input_dim = 2   # 입력 2D point\n",
        "output_dim = 1   # 출력 예측은 샘플당 하나의 점수 (0에 가까우면 클래스0으로, 1에 가까우면 클래스1로 예측)\n",
        "W = tf.Variable(initial_value=tf.random.uniform(shape=(input_dim, output_dim)))\n",
        "b = tf.Variable(initial_value=tf.zeros(shape=(output_dim,)))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 38,
      "metadata": {
        "id": "OwYa9OHzQQMP"
      },
      "outputs": [],
      "source": [
        "def model(inputs, W, b):\n",
        "    return tf.matmul(inputs, W) + b   # matmul(): matrix multiplication\n",
        "# y = xW + b\n",
        "# predictions = [[w1], [w2]] • [x, y] + b = w1 * x + w2 * y + b\n",
        "# similar to linear regression"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 39,
      "metadata": {
        "id": "SuBtFUQNQQMQ"
      },
      "outputs": [],
      "source": [
        "def mean_squared_error(targets, predictions):\n",
        "    per_sample_losses = tf.square(targets - predictions)\n",
        "    return tf.reduce_mean(per_sample_losses)   # tf.reduce_mean: 계산된 모든 제곱 오차의 평균\n",
        "# mse"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 40,
      "metadata": {
        "id": "8UdTszg_QQMQ"
      },
      "outputs": [],
      "source": [
        "learning_rate = 0.1   # 한 번에 얼마나 크게 가중치를 수정할지 결정 (너무 크면 최적값을 지나칠 수 있고, 너무 작으면 학습이 느림)\n",
        "\n",
        "@tf.function(jit_compile=True)\n",
        "def training_step(inputs, targets, W, b):\n",
        "    with tf.GradientTape() as tape:   # tape 안에서 tf.Variable (W와 b)에 대해 수행되는 모든 연산이 기록. 나중에 이 변수들에 대한 손실 함수의 기울기를 계산할 수 있게 함\n",
        "        predictions = model(inputs, W, b)   # 앞에서 설정한 model: predictions = [[w1], [w2]] • [x, y] + b = w1 * x + w2 * y + b\n",
        "        loss = mean_squared_error(predictions, targets)   # 예측이 얼마나 틀렸는지 계산\n",
        "    grad_loss_wrt_W, grad_loss_wrt_b = tape.gradient(loss, [W, b])   # W와 b를 어느 방향으로 바꿔야 하는지 계산\n",
        "    W.assign_sub(grad_loss_wrt_W * learning_rate)   # 경사하강법으로 가중치 W 업데이트 (assign_sub(): -= (값을 빼서 업데이트))\n",
        "    b.assign_sub(grad_loss_wrt_b * learning_rate)   # b 업데이트 (b <- b - (dl/db)*learning_rate)\n",
        "    return loss\n",
        "# 추정값을 한번에 계산하는 linear regression과 달리 gradient descent를 이용하여 parameter 찾기\n",
        "# 예측 -> 오차 계산 -> 미분 -> 가중치 수정"
      ]
    },
