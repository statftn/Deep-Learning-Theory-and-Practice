      "source": [
        "my_dense = SimpleDense(units=32, activation=keras.ops.relu)   # output 뉴런 32개, 활성화 함수 relu\n",
        "input_tensor = keras.ops.ones(shape=(2, 784))\n",
        "output_tensor = my_dense(input_tensor)\n",
