    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "FiZq5H_8P0Mb"
      },
      "outputs": [],
      "source": [
        "x = np.random.random((32,))   # 32개의 0과 1 사이 부동소수점 숫자를 요소로 가진 1차원 배열(벡터)\n",
        "y = np.random.random((32,))\n",
        "\n",
        "z = np.matmul(x, y)   # 두 배열의 행렬 곱셈. 두 벡터가 1차원인 경우, 두 벡터의 내적(dot product)을 계산\n",
        "z = x @ y   #  NumPy 배열에 대해서는 np.matmul()과 동일하게 행렬 곱셈을 수행"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "56sJwChHP0Mb"
      },
      "outputs": [],
      "source": [
        "def naive_vector_product(x, y):\n",
        "    assert len(x.shape) == 1\n",
        "    assert len(y.shape) == 1\n",
        "    assert x.shape[0] == y.shape[0]\n",
        "    z = 0.0\n",
        "    for i in range(x.shape[0]):\n",
        "        z += x[i] * y[i]\n",
        "    return z\n",
        "# 두 배열(벡터)의 내적 계산"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "yS0yB8ylP0Mb"
      },
      "outputs": [],
      "source": [
        "def naive_matrix_vector_product(x, y):\n",
        "    assert len(x.shape) == 2\n",
        "    assert len(y.shape) == 1\n",
        "    assert x.shape[1] == y.shape[0]\n",
        "    z = np.zeros(x.shape[0])\n",
        "    for i in range(x.shape[0]):\n",
        "        for j in range(x.shape[1]):\n",
        "            z[i] += x[i, j] * y[j]\n",
        "    return z\n",
        "# 행렬-벡터 dot product (벡터가 반환)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Tw0dkCCKP0Mb"
      },
      "outputs": [],
      "source": [
        "def naive_matrix_vector_product(x, y):\n",
        "    z = np.zeros(x.shape[0])\n",
        "    for i in range(x.shape[0]):\n",
        "        z[i] = naive_vector_product(x[i, :], y)\n",
        "    return z\n",
        "# 행렬-벡터 dot product와 벡터-벡터 dot product 관계\n",
        "# 두 텐서 중 하나라도 ndim이 1보다 크면 교환법칙 성립하지 않음\n",
        "# dot(x, y) != dot(y, x)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "qD34LParP0Mb"
      },
      "outputs": [],
      "source": [
        "def naive_matrix_product(x, y):\n",
        "    assert len(x.shape) == 2\n",
        "    assert len(y.shape) == 2\n",
        "    assert x.shape[1] == y.shape[0]   # x의 두 번째 차원과 y의 첫 번째 차원이 같다\n",
        "    z = np.zeros((x.shape[0], y.shape[1]))   # 0이 채워진 벡터\n",
        "    for i in range(x.shape[0]):\n",
        "        for j in range(y.shape[1]):\n",
        "            row_x = x[i, :]\n",
        "            column_y = y[:, j]\n",
        "            z[i, j] = naive_vector_product(row_x, column_y)\n",
        "    return z\n",
        "# 두 행렬 간의 dot product\n",
        "\n",
        "# 고차원 텐서 간의 dot product\n",
        "# (a, b, c, d)·(d,) -> (a, b, c)\n",
        "# (a, b, c, d)·(d, e) -> (a, b, c, e)"
      ]
