        "def naive_relu(x):\n",
        "    assert len(x.shape) == 2   # x가 2차원 배열인지 확인\n",
        "    x = x.copy()\n",
        "    for i in range(x.shape[0]):\n",
        "        for j in range(x.shape[1]):\n",
        "            x[i, j] = max(x[i, j], 0)   # 모든 요소에 대해 0보다 작으면 0으로, 아니면 원래 값 유지 (ReLU)\n",
        "    return x\n",
        "# element-wise calculation (느림)\n",
        "# 4 loops -> 시간 많이 걸림\n",
        "# ReLU 활성화 함수를 NumPy 배열에 적용하는 비효율적인(naive) 방법"
      ]
    },
