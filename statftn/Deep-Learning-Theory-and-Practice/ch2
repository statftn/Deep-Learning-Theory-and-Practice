      "source": [
        "import keras\n",
        "from keras import layers\n",
        "\n",
        "model = keras.Sequential(\n",
        "    [\n",
        "        layers.Dense(512, activation=\"relu\"),\n",
        "        layers.Dense(10, activation=\"softmax\"),\n",
        "    ]\n",
        ")\n",
        "# 모델 설정\n",
        "# 2개의 dense layer\n",
        "# 첫 번째 dense layer는 512개의 유닛을 갖고 relu 활성화 함수를 사용 (중간층에서 복잡한 특징을 학습 -> 특징 추출)\n",
        "# 두 번째 dense layer는 10개의 유닛을 갖고 softmax(다중분류) 활성화 함수를 사용 (0~9까지 10개 숫자 분류)\n",
        "# softmax 함수: 마지막 출력값들을 각 클래스일 확률값으로 변환 (모든 확률 더하면 1)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "5zaWzzvwP0MT"
      },
      "outputs": [],
      "source": [
        "model.compile(\n",
        "    optimizer=\"adam\",\n",
        "    loss=\"sparse_categorical_crossentropy\",\n",
        "    metrics=[\"accuracy\"],\n",
        ")\n",
        "# 학습 방법\n",
        "# compile: 모델을 어떻게 학습할지 결정하는 함수\n",
        "# optimizer: 모델의 가중치를 업데이트하는 데 사용되는 최적화 알고리즘 (손실에 대한 그레디언트가 파라미터를 업데이트하는 정확한 방식을 정의)\n",
        "# loss: 모델의 예측이 얼마나 틀렸는지를 측정하는 함수 (sparse_categorical_crossentropy: 다중 클래스 분류에 적합)\n",
        "# metrics: 훈련 및 테스트 단계에서 모델의 성능을 평가하는 데 사용되는 지표"
      ]
